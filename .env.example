# Alamat publik. Ganti angka IP dengan public IP VM Oracle Cloud.
# Format sslip.io memakai IP yang sama, mis. 203.0.113.10.sslip.io
SITE_ADDRESS=mangashelf.203.0.113.10.sslip.io

# Kata sandi untuk membuka aplikasi. Wajib; gunakan minimal 16 karakter.
MANGA_PASSWORD=ganti-dengan-kata-sandi-panjang

# Kunci acak penanda tangan cookie sesi. Buat dengan: openssl rand -hex 32
MANGA_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
